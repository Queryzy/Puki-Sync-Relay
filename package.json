{
  "name": "puki-sync-relay",
  "version": "1.0.0",
  "description": "Zero-Knowledge Blind Ledger Sync Relay for Puki Music (Cloudflare Workers & Docker)",
  "main": "dist/worker.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run build:bundle",
    "build:bundle": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/bundle.mjs --external:node:sqlite",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "start:docker": "node dist/bundle.mjs",
    "test": "node --test test/relay.test.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.17.19",
    "typescript": "^5.7.2",
    "wrangler": "^3.101.0"
  }
}
